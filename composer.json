{
    "name": "genealabs/laravel-null-carbon",
    "description": "A Laravel Carbon null-class.",
    "license": "MIT",
    "authors": [
        {
            "name": "GeneaLabs, LLC",
            "email": "hello@genealabs.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0"
    },
    "require-dev": {
        "symfony/thanks" : "^1.2",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "GeneaLabs\\LaravelNullCarbon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeneaLabs\\LaravelNullCarbon\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/thanks": true
        }
    }
}
